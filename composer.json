  "require": {
    "composer/installers": "^2.0",
    "log1x/acf-editor-palette": "^1.0",
    "oscarotero/env": "^2.1",
    "php": ">=7.1",
    "private-plugin/advanced-custom-fields-pro": "^5.10",
    "private-plugin/wp-rocket": "^3.9",
    "private-plugin/wpml-advanced-custom-fields-mutlilingual": "^1.8",
    "private-plugin/wpml-cms-navigation": "^1.5",
    "private-plugin/wpml-media-translation": "^2.6",
    "private-plugin/wpml-multilingual-cms": "^4.4",
    "private-plugin/wpml-sticky-links": "^1.5",
    "private-plugin/wpml-string-translation": "^3.1",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "6.8.3",
    "roots/wp-config": "1.0.0",
    "roots/wp-password-bcrypt": "1.1.0",
    "vlucas/phpdotenv": "^5.4",
    "wpackagist-plugin/acf-content-analysis-for-yoast-seo": "^3.0",
    "wpackagist-plugin/better-search-replace": "^1.3",
    "wpackagist-plugin/classic-editor": "^1.6",
    "wpackagist-plugin/cookie-law-info": "^3.0",
    "wpackagist-plugin/disable-comments": "^2.1",
    "wpackagist-plugin/duplicate-page": "^4.4",
    "wpackagist-plugin/google-site-kit": "^1.89",
    "wpackagist-plugin/post-types-order": "^1.9",
    "wpackagist-plugin/svg-support": "^2.3",
    "wpackagist-plugin/tinymce-advanced": "^5.6",
    "wpackagist-plugin/wordpress-seo": "^18.0",
    "wpackagist-plugin/worker": "^4.9",
    "wpackagist-plugin/wp-mail-smtp": "^3.4",
    "wpackagist-plugin/contact-form-7": "^5.9"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.6.2"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "ffraenz/private-composer-installer": true,
      "roots/wordpress-core-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin",
        "wpackagist-plugin/disable-comments",
        "wpackagist-plugin/duplicate-page",
        "wpackagist-plugin/simple-custom-post-order",
        "wpackagist-plugin/toolbar-publish-button"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"copy('.env.example', '.env');\"",
      "composer suggests"
    ],
    "post-install-cmd": [
      "composer suggests"
    ],
    "test": [
      "phpcs"
    ]
  }
}
