<?php
namespace DummyNamespace;

use App\Fixtures\Taxonomy;
use StoutLogic\AcfBuilder\FieldsBuilder;

class DummyClass extends Taxonomy
{
    /**
     * The taxonomy menu name.
     *
     * @var string
     */
    public $name = 'DummyTitle';

    /**
     * The taxonomy singular form.
     *
     * @var string
     */
    public $singularName = '';

    /**
     * The taxonomy description.
     *
     * @var string
     */
    public $description = 'A simple DummyTitle taxonomy.';

    /**
     * The taxonomy post types.
     *
     * @var string
     */
    public $types = [];

    /**
     * The taxonomy default terms.
     * @see https://developer.wordpress.org/reference/functions/wp_insert_term/
     * @var string
     */
    public $defaultTerms = [];

    /**
     * The custom post field group.
     *
     * @return array|FieldsBuilder
     */
    public function fields()
    {
        $DummyCamelFields = new FieldsBuilder('DummySnake_fields');
        $DummyCamelFields
            ->addImage('image', [
                'return_format' => 'id',
                'preview_size' => 'thumbnail',
            ]);

        return $DummyCamelFields;
    }
}
