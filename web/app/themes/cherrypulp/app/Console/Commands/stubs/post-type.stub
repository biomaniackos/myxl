<?php
namespace DummyNamespace;

use App\Fixtures\PostType;
use StoutLogic\AcfBuilder\FieldsBuilder;

class DummyClass extends PostType
{
    /**
     * The post type menu name.
     *
     * @var string
     */
    public $name = 'DummyTitle';

    /**
     * The post type plural form.
     *
     * @var string
     */
    public $singularName = 'DummyTitle';

    /**
     * The post type description.
     *
     * @var string
     */
    public $description = 'A simple DummyTitle post type.';

    /**
     * The post type icon.
     *
     * @var string
     */
    public $icon = 'dashicons-admin-page';

    /**
     * The post type supports.
     *
     * @var string[]
     */
    public $supports = [
        'author',
        'editor',
        'thumbnail',
        'title',
    ];

    /**
     * The custom post field group.
     *
     * @return array|FieldsBuilder
     */
    public function fields()
    {
        $DummyCamelFields = new FieldsBuilder('DummySnake_fields');
        $DummyCamelFields
            ->addImage('image', [
                'return_format' => 'id',
                'preview_size' => 'thumbnail',
            ]);

        return $DummyCamelFields;
    }

    /**
     * The custom post options page field group.
     *
     * @return array|FieldsBuilder
     */
    public function options()
    {
        $DummyCamelSettings = new FieldsBuilder('DummySnake_settings');
        $DummyCamelSettings->addText('title');
        return $DummyCamelSettings;
    }
}
