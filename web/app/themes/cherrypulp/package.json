{
  "private": true,
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "engines": {
    "node": ">=12.14.0"
  },
  "scripts": {
    "build": "mix",
    "build:production": "yarn clean && mix --production",
    "start": "mix watch",
    "hot": "mix watch --hot",
    "clear": "wp acorn optimize:clear",
    "clean": "yarn clean:dist && yarn clean:cache && yarn clean:views",
    "clean:dist": "rimraf dist",
    "clean:cache": "rimraf storage/framework/cache/*.php storage/framework/cache/data/*.php",
    "clean:views": "rimraf storage/framework/views/*.php",
    "test": "yarn lint",
    "lint": "yarn lint:js && yarn lint:css",
    "lint:js": "eslint resources/scripts",
    "lint:css": "stylelint \"resources/**/*.{css,scss,vue}\"",
    "translate": "yarn translate:pot && yarn translate:js",
    "translate:pot": "wp i18n make-pot . ./resources/lang/sage.pot --ignore-domain --include=\"app,resources\"",
    "translate:js": "wp i18n make-json ./resources/lang --pretty-print"
  },
  "devDependencies": {
    "@postcss-plugins/text-transform": "^0.1.2",
    "@tinypixelco/laravel-mix-wp-blocks": "^1.1.0",
    "@vue/compiler-sfc": "^3.2.19",
    "@wordpress/babel-preset-default": "^6.3.1",
    "@wordpress/browserslist-config": "^4.1.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^3.2.1",
    "autoprefixer": "^10.3.3",
    "babel-eslint": "^10.1.0",
    "browser-sync": "^2.27.5",
    "browser-sync-webpack-plugin": "^2.3.0",
    "dotenv": "^10.0.0",
    "eslint": "^8.1.0",
    "eslint-plugin-import": "^2.24.2",
    "laravel-mix": "^6.0.28",
    "postcss": "^8.3.6",
    "postcss-assets": "^6.0.0",
    "postcss-color-function": "^4.1.0",
    "postcss-custom-properties": "^12.0.0",
    "postcss-each": "^1.1.0",
    "postcss-for": "^2.1.1",
    "postcss-loader": "^6.2.0",
    "postcss-mixins": "^8.1.0",
    "postcss-nested": "^5.0.6",
    "postcss-scss": "^4.0.0",
    "rimraf": "^3.0.2",
    "stylelint": "^14.0.1",
    "stylelint-config-recommended": "^6.0.0",
    "tailwindcss": "^2.2.9",
    "vue-loader": "^16.2.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-pro": "^5.15.4",
    "@headlessui/vue": "^1.4.1",
    "@tailwindcss/aspect-ratio": "^0.3.0",
    "@tailwindcss/forms": "^0.3.3",
    "@tailwindcss/line-clamp": "^0.2.1",
    "aos": "^3.0.0-beta.6",
    "axios": "^0.24.0",
    "leaflet": "^1.7.1",
    "parallax-js": "^3.1.0",
    "slim-select": "^1.27.0",
    "tailwindcss-children": "^2.1.0",
    "tailwindcss-debug-screens": "^2.1.0",
    "tailwindcss-elevation": "^1.0.1",
    "tailwindcss-responsive-embed": "^1.0.0",
    "vue": "^3.2.19"
  }
}
